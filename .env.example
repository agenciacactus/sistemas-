# Banco de dados
# Desenvolvimento (padrão): SQLite local
DATABASE_URL="file:./dev.db"

# Produção: troque o provider em prisma/schema.prisma para "postgresql"
# e use uma URL como:
# DATABASE_URL="postgresql://usuario:senha@host:5432/cactus?schema=public"

# IA (opcional) — chave da API do Claude para o resumo executivo em "IA & Insights".
# Sem ela, o resumo é montado por template (os alertas funcionam sempre).
# ANTHROPIC_API_KEY="sk-ant-..."

# Integrações externas (opcional) — credenciais OAuth das plataformas.
# Sem elas, a tela "Integrações" mostra os provedores como "não configurado"
# e os módulos seguem com dados de demonstração.
# Meta Ads (Facebook/Instagram) — https://developers.facebook.com/apps
# META_APP_ID=""
# META_APP_SECRET=""
# Google Ads e GA4 (mesmo cliente OAuth) — https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
