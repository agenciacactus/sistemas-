// Schema do Sistema de Gestão de Agências (Cactus)
// Modela toda a visão: multi-agência, clientes, projetos, comercial (fee/peças),
// financeiro, mídia/tráfego pago e gestão de redes sociais (estilo mLabs).
// Dev usa SQLite; para produção troque o provider para "postgresql".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// NÚCLEO / MULTI-AGÊNCIA
// ---------------------------------------------------------------------------

model Agency {
  id        String   @id @default(cuid())
  name      String
  cnpj      String?
  email     String?
  phone     String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  clients          Client[]
  projects         Project[]
  proposals        Proposal[]
  deliverables     Deliverable[]
  financialEntries FinancialEntry[]
  mediaPlans       MediaPlan[]
  campaigns        Campaign[]
  socialAccounts   SocialAccount[]
  socialPosts      SocialPost[]
  timeEntries      TimeEntry[]
  analytics        AnalyticsDaily[]
  suppliers        Supplier[]
  quotations       Quotation[]
  productionOrders ProductionOrder[]
}

enum Role {
  OWNER // dono / administrador geral
  MANAGER // atendimento / gestor de contas
  TRAFFIC // gestor de tráfego pago
  SOCIAL // social media / gestão de redes
  PRODUCTION // produção / criação
  FINANCE // financeiro
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MANAGER)
  active       Boolean  @default(true)
  // custo por hora do colaborador (em centavos) — base do cálculo de rentabilidade
  hourlyCostCents Int   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  sessions         Session[]
  managedClients   Client[]     @relation("AccountManager")
  createdProposals Proposal[]
  managedCampaigns Campaign[]
  assignedPosts    SocialPost[]
  timeEntries      TimeEntry[]
  createdQuotations       Quotation[]
  createdProductionOrders ProductionOrder[]

  @@index([agencyId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// CLIENTES E PROJETOS
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  PROSPECT
  PAUSED
  CHURNED
}

model Client {
  id        String       @id @default(cuid())
  name      String
  cnpj      String?
  segment   String?
  contact   String?
  email     String?
  phone     String?
  status    ClientStatus @default(ACTIVE)
  notes     String?
  // token do portal público de aprovação (link compartilhável com o cliente)
  portalToken String?    @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  accountManagerId String?
  accountManager   User?   @relation("AccountManager", fields: [accountManagerId], references: [id])

  projects         Project[]
  proposals        Proposal[]
  deliverables     Deliverable[]
  financialEntries FinancialEntry[]
  mediaPlans       MediaPlan[]
  campaigns        Campaign[]
  socialAccounts   SocialAccount[]
  timeEntries      TimeEntry[]
  analytics        AnalyticsDaily[]
  quotations       Quotation[]
  productionOrders ProductionOrder[]

  @@index([agencyId])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  DONE
  CANCELLED
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  deliverables Deliverable[]
  mediaPlans   MediaPlan[]
  campaigns    Campaign[]
  socialPosts  SocialPost[]
  timeEntries  TimeEntry[]
  quotations   Quotation[]

  @@index([clientId])
  @@index([agencyId])
}

// ---------------------------------------------------------------------------
// COMERCIAL: PROPOSTAS DE FEE E PEÇAS AVULSAS
// ---------------------------------------------------------------------------

enum ProposalType {
  FEE_MENSAL // contrato de fee recorrente
  PROJETO // projeto pontual
  PECA_AVULSA // peça/serviço avulso
}

enum ProposalStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

model Proposal {
  id         String         @id @default(cuid())
  number     String
  title      String
  type       ProposalType   @default(FEE_MENSAL)
  status     ProposalStatus @default(DRAFT)
  // valor total calculado a partir dos itens (armazenado em centavos)
  totalCents Int            @default(0)
  // para fee mensal: recorrência em meses
  months     Int?
  validUntil DateTime?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  items ProposalItem[]

  @@index([agencyId])
  @@index([clientId])
}

model ProposalItem {
  id          String @id @default(cuid())
  description String
  quantity    Int    @default(1)
  unitCents   Int    @default(0) // valor unitário em centavos

  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

// Peças/entregáveis de produção (peças avulsas ou dentro de projetos)
enum DeliverableStatus {
  BRIEFING
  IN_PRODUCTION
  REVIEW
  APPROVAL
  DELIVERED
}

// Retorno do cliente no portal de aprovação
enum ApprovalStatus {
  PENDING // aguardando o cliente
  APPROVED // aprovado pelo cliente
  CHANGES_REQUESTED // cliente pediu ajustes
}

model Deliverable {
  id         String            @id @default(cuid())
  title      String
  type       String? // ex: post, banner, vídeo, landing page
  status     DeliverableStatus @default(BRIEFING)
  // aprovação do cliente via portal
  approval   ApprovalStatus    @default(PENDING)
  clientNote String? // observação do cliente ao pedir ajustes
  reviewedAt DateTime? // quando o cliente revisou
  previewUrl String? // link/arquivo da peça para o cliente ver
  dueDate    DateTime?
  priceCents Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// FINANCEIRO
// ---------------------------------------------------------------------------

enum EntryType {
  RECEIVABLE // a receber
  PAYABLE // a pagar
}

enum EntryStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model FinancialEntry {
  id          String      @id @default(cuid())
  description String
  type        EntryType
  status      EntryStatus @default(PENDING)
  amountCents Int
  category    String? // ex: fee, mídia, produção, imposto
  dueDate     DateTime
  paidAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // origem: pedido de produção que gerou este lançamento (quando aplicável)
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([status])
  @@index([productionOrderId])
}

// ---------------------------------------------------------------------------
// MÍDIA E TRÁFEGO PAGO
// ---------------------------------------------------------------------------

model MediaPlan {
  id          String   @id @default(cuid())
  name        String
  period      String? // ex: "Jul/2026"
  budgetCents Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  campaigns Campaign[]

  @@index([agencyId])
  @@index([clientId])
}

enum AdPlatform {
  META // Facebook / Instagram
  GOOGLE
  TIKTOK
  LINKEDIN
  OUTRO
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum CampaignObjective {
  AWARENESS
  TRAFFIC
  ENGAGEMENT
  LEADS
  SALES
}

model Campaign {
  id          String            @id @default(cuid())
  name        String
  platform    AdPlatform        @default(META)
  objective   CampaignObjective @default(TRAFFIC)
  status      CampaignStatus    @default(DRAFT)
  budgetCents Int               @default(0)
  spentCents  Int               @default(0)
  // métricas (sincronizadas via integração de ads)
  impressions Int               @default(0)
  clicks      Int               @default(0)
  conversions Int               @default(0)
  externalId  String? // id da campanha na plataforma (Meta/Google)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  mediaPlanId String?
  mediaPlan   MediaPlan? @relation(fields: [mediaPlanId], references: [id], onDelete: SetNull)

  managerId String?
  manager   User?   @relation(fields: [managerId], references: [id])

  @@index([agencyId])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// GESTÃO DE REDES SOCIAIS (estilo mLabs)
// ---------------------------------------------------------------------------

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  YOUTUBE
  X
}

model SocialAccount {
  id          String         @id @default(cuid())
  platform    SocialPlatform
  handle      String // @perfil
  externalId  String? // id da conta na plataforma
  accessToken String? // token de integração (criptografar em produção)
  connected   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  posts SocialPost[]

  @@index([agencyId])
  @@index([clientId])
}

enum PostStatus {
  IDEA
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

model SocialPost {
  id          String     @id @default(cuid())
  caption     String
  mediaUrl    String?
  status      PostStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  externalId  String? // id do post publicado na plataforma
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  accountId String
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  @@index([agencyId])
  @@index([accountId])
  @@index([scheduledAt])
}

// ---------------------------------------------------------------------------
// APONTAMENTO DE HORAS (base da rentabilidade por conta)
// ---------------------------------------------------------------------------

model TimeEntry {
  id          String   @id @default(cuid())
  date        DateTime
  hours       Float
  description String?
  // custo em centavos, "congelado" no momento do apontamento
  // (hours * hourlyCostCents do colaborador) para preservar histórico
  costCents   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([clientId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// ANALYTICS (métricas de site — estilo GA4, prontas para sincronização)
// ---------------------------------------------------------------------------

enum Channel {
  ORGANIC // busca orgânica
  PAID // mídia paga
  SOCIAL // redes sociais
  DIRECT // acesso direto
  REFERRAL // referência
}

model AnalyticsDaily {
  id          String   @id @default(cuid())
  date        DateTime
  channel     Channel
  sessions    Int      @default(0)
  users       Int      @default(0)
  conversions Int      @default(0)

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([clientId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// COTAÇÃO COM FORNECEDORES E PEDIDO DE PRODUÇÃO
// Fluxo: cadastra fornecedores → cria pedido de cotação com itens → dispara
// por e-mail/WhatsApp aos fornecedores → monta os orçamentos recebidos →
// escolhe o vencedor e gera o pedido de produção (com BV da agência e a
// forma de faturamento contra o cliente).
// ---------------------------------------------------------------------------

enum SupplierCategory {
  GRAFICA // gráfica / impressos
  BRINDES // brindes e presentes
  AUDIOVISUAL // produção de áudio e vídeo
  FOTOGRAFIA // fotografia
  EVENTOS // eventos e ativações
  IMPRESSAO_GRANDE // impressão em grande formato / comunicação visual
  WEB_TECH // desenvolvimento / tecnologia
  OUTRO
}

model Supplier {
  id        String           @id @default(cuid())
  name      String
  cnpj      String?
  category  SupplierCategory @default(OUTRO)
  contact   String? // pessoa de contato
  email     String?
  phone     String? // usado para disparo via WhatsApp
  city      String?
  notes     String?
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  quotes SupplierQuote[]

  @@index([agencyId])
}

enum QuotationStatus {
  DRAFT // rascunho, montando os itens
  SENT // pedido de cotação disparado aos fornecedores
  QUOTED // ao menos um fornecedor respondeu
  ORDERED // já gerou pedido de produção
  CANCELLED
}

model Quotation {
  id        String          @id @default(cuid())
  number    String
  title     String
  status    QuotationStatus @default(DRAFT)
  deadline  DateTime? // prazo para os fornecedores responderem
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  items            QuotationItem[]
  supplierQuotes   SupplierQuote[]
  productionOrders ProductionOrder[]

  @@index([agencyId])
  @@index([clientId])
}

model QuotationItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int     @default(1)
  unit        String  @default("un") // un, mil, m², cx, h...
  spec        String? // especificação técnica (cor, material, formato)

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  quoteLines SupplierQuoteLine[]

  @@index([quotationId])
}

enum SupplierQuoteStatus {
  INVITED // convidado (disparo pendente ou já enviado)
  RECEIVED // orçamento recebido/preenchido no sistema
  SELECTED // escolhido para o pedido de produção
  REJECTED // descartado
}

// Canal pelo qual o pedido de cotação foi disparado ao fornecedor
enum DispatchChannel {
  NONE
  EMAIL
  WHATSAPP
  BOTH
}

model SupplierQuote {
  id           String              @id @default(cuid())
  status       SupplierQuoteStatus @default(INVITED)
  channel      DispatchChannel     @default(NONE)
  sentAt       DateTime? // quando o pedido foi disparado
  respondedAt  DateTime? // quando o orçamento foi lançado
  totalCents   Int                 @default(0) // soma das linhas
  leadTimeDays Int? // prazo de entrega informado pelo fornecedor
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  lines            SupplierQuoteLine[]
  productionOrders ProductionOrder[]

  @@unique([quotationId, supplierId])
  @@index([quotationId])
  @@index([supplierId])
}

model SupplierQuoteLine {
  id        String @id @default(cuid())
  unitCents Int    @default(0) // preço unitário ofertado para o item

  supplierQuoteId String
  supplierQuote   SupplierQuote @relation(fields: [supplierQuoteId], references: [id], onDelete: Cascade)

  itemId String
  item   QuotationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([supplierQuoteId, itemId])
  @@index([supplierQuoteId])
  @@index([itemId])
}

// Forma de faturamento do pedido de produção contra o cliente
enum BillingMethod {
  SIGA // Faturamento SIGA — o fornecedor fatura direto o cliente e a agência recebe o BV
  FATURADO_LIQUIDO // Faturado líquido contra o cliente aos cuidados da agência
}

enum ProductionOrderStatus {
  OPEN // aberto / aguardando produção
  IN_PRODUCTION // em produção
  DELIVERED // entregue
  INVOICED // faturado
  CANCELLED
}

model ProductionOrder {
  id            String                @id @default(cuid())
  number        String
  status        ProductionOrderStatus @default(OPEN)
  billingMethod BillingMethod         @default(FATURADO_LIQUIDO)
  // BV da agência (Bonificação de Volume) em % — markup sobre o custo do fornecedor
  bvPercent     Float                 @default(0)
  // custo líquido do fornecedor "congelado" no momento do pedido (centavos)
  supplierCostCents Int               @default(0)
  // valor do BV calculado (centavos)
  bvCents          Int                @default(0)
  // total faturado contra o cliente (custo + BV) em centavos
  clientTotalCents Int                @default(0)
  deliveryDate     DateTime?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  supplierQuoteId String
  supplierQuote   SupplierQuote @relation(fields: [supplierQuoteId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  financialEntries FinancialEntry[]

  @@index([agencyId])
  @@index([quotationId])
  @@index([clientId])
}
